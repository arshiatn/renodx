  r4.yzw = r6.zzz ? cb2[27].xyz : r4.yzw;
  r4.yzw = r6.www ? cb2[28].xyz : r4.yzw;
  r3.xzw = r3.xxx ? r4.yzw : r5.xyz;
  r3.xzw = r1.yyy ? r3.xzw : r5.xyz;
  r3.xzw = r0.xxx ? r3.xzw : r5.xyz;
  r4.yzw = r0.www ? r3.xzw : r5.xyz;
  r0.xyw = r0.yyy ? r4.yzw : r3.xzw;
  r0.xyw = r3.yyy ? r5.xyz : r0.xyw;
  r0.xyz = r0.zzz ? r0.xyw : r2.xyz;
  r0.xyz = r1.zzz ? r0.xyz : r2.xyz;
  r2.xyz = r1.xxx * r0.xyz;
  r0.xyz = r1.yyy ? r0.xyz : r2.xyz;
  r1.xyz = cb2[50].zzz * r0.xyz;
  r1.xyz = r4.xxx ? r5.xyz : r1.xyz;
  r0.xyz = r1.www ? r0.xyz : r1.xyz;
  r0.xyz = cb2[47].xyz + r0.xyz;
  // Negative BT.709 channels carry wide-gamut HDR; SDR keeps the original clip.
  o0.xyz = (HDR >= 1.f && SI.peak_white_nits > 0.f) ? r0.xyz : max(float3(0,0,0), r0.xyz);
  o0.w = 1;
  return;
}
