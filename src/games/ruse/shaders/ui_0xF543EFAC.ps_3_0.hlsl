// Native UI math from the supplied dump; brightness is applied only at the final UI draw.
#include "./ui.hlsli"

float2 uniAutoTexelDUDV_uniInterfaceMap : register(c2);
float uniAuto_BorderCutValue : register(c3);
float uniAuto_BorderSmoothing : register(c4);
sampler2D uniInterfaceMap;
float3 uniAuto_StrokeParam : register(c1);
float2 uniHDRParam;

struct PS_IN
{
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float2 texcoord : TEXCOORD;
	float2 texcoord1 : TEXCOORD1;
	float2 texcoord2 : TEXCOORD2;
};

half4 OriginalUI(PS_IN i) : COLOR
{
	half4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	float4 r9;
	float4 r10;
	float4 r11;
	r0.z = 0;
	r1.xy = ddy(i.texcoord.xy);
	r0.xy = r1.xy * -0.5 + i.texcoord.xy;
	r1.xy = r1.xy * 0.5 + i.texcoord.xy;
	r2.xw = float2(0.5, 1);
	r3.xy = uniAutoTexelDUDV_uniInterfaceMap.xy * -r2.xx + i.texcoord2.xy;
	r4.z = r3.x;
	r2.yz = -r0.xy + r3.xy;
	r4.xy = r0.xy + -r3.xy;
	r5.xy = (r2.yy >= 0) ? r0.xz : r4.zx;
	r6.xy = uniAutoTexelDUDV_uniInterfaceMap.xy * r2.xx + i.texcoord1.xy;
	r7.z = r6.x;
	r2.xy = r0.xy + -r6.xy;
	r7.xy = -r0.xy + r6.xy;
	r0.xw = (r2.xx >= 0) ? r5.xy : r7.zx;
	r5.w = r7.y + r0.w;
	r8.w = r4.y + r0.w;
	r8.z = r3.y;
	r2.xz = (r2.zz >= 0) ? r0.yw : r8.zw;
	r5.z = r6.y;
	r0.yz = (r2.yy >= 0) ? r2.xz : r5.zw;
	r0.z = r0.z * 256;
	r9 = tex2D(uniInterfaceMap, r0.xy);
	r2.x = min(r0.z, 1);
	r0 = r2.x * -r9 + r9;
	r1.z = 0;
	r4.xw = r1.yx + -r3.yx;
	r2.xy = -r1.xy + r3.xy;
	r2.xz = (r2.xx >= 0) ? r1.xz : r4.zw;
	r7.xw = -r1.yx + r6.yx;
	r9.xy = r1.xy + -r6.xy;
	r1.xw = (r9.xx >= 0) ? r2.xz : r7.zw;
	r8.w = r4.x + r1.w;
	r2.xy = (r2.yy >= 0) ? r1.yw : r8.zw;
	r5.w = r7.x + r1.w;
	r1.yz = (r9.yy >= 0) ? r2.xy : r5.zw;
	r9 = tex2D(uniInterfaceMap, r1.xy);
	r1.x = r1.z * 256;
	r2.x = min(r1.x, 1);
	r1 = r2.x * -r9 + r9;
	r9 = max(r1, r0);
	r10 = min(r0, r1);
	r0.z = 0;
	r1.xy = ddx(i.texcoord.xy);
	r0.xy = r1.xy * 0.5 + i.texcoord.xy;
	r1.xy = r1.xy * -0.5 + i.texcoord.xy;
	r2.xy = -r0.xy + r3.xy;
	r3.zw = -r3.xy + r0.xy;
	r2.xz = (r2.xx >= 0) ? r0.xz : r3.xz;
	r11.xy = -r6.xy + r0.xy;
	r6.zw = -r0.xy + r6.xy;
	r0.xw = (r11.xx >= 0) ? r2.xz : r6.xz;
	r5.x = r6.w + r0.w;
	r8.x = r3.w + r0.w;
	r2.xy = (r2.yy >= 0) ? r0.yw : r8.zx;
	r0.yz = (r11.yy >= 0) ? r2.xy : r5.zx;
	r11 = tex2D(uniInterfaceMap, r0.xy);
	r0.x = r0.z * 256;
	r2.x = min(r0.x, 1);
	r0 = r2.x * -r11 + r11;
	r1.z = 0;
	r2.xy = -r1.xy + r3.xy;
	r4.xy = -r3.xy + r1.xy;
	r2.xz = (r2.xx >= 0) ? r1.xz : r4.zx;
	r3.xy = -r6.xy + r1.xy;
	r7.xy = -r1.xy + r6.xy;
	r1.xw = (r3.xx >= 0) ? r2.xz : r7.zx;
	r5.y = r7.y + r1.w;
	r8.y = r4.y + r1.w;
	r2.xy = (r2.yy >= 0) ? r1.yw : r8.zy;
	r1.yz = (r3.yy >= 0) ? r2.xy : r5.zy;
	r3 = tex2D(uniInterfaceMap, r1.xy);
	r1.x = r1.z * 256;
	r2.x = min(r1.x, 1);
	r1 = r2.x * -r3 + r3;
	r3 = max(r0, r1);
	r4 = min(r1, r0);
	r0 = min(r10, r4);
	r1 = max(r3, r9);
	r3 = r0 + r1;
	r0 = -r0 + r1;
	r1 = max(r0, 0.001);
	r0 = r3 * 0.5;
	r2.x = max(r0.x, r0.z);
	r3.x = min(r0.y, r2.x);
	r0.x = max(r1.x, r1.z);
	r2.x = max(r0.x, r1.y);
	r3.yzw = float3(1.3, 10, 2);
	r0.x = r1.w * r3.w + uniAuto_BorderSmoothing.x;
	r0.y = r2.x * r3.y + uniAuto_BorderSmoothing.x;
	r1.xy = r0.yy * float2(-0.5, 0.5) + r3.xx;
	r0.z = r3.z + -uniAuto_BorderCutValue.x;
	r0.z = 1 / r0.z;
	r1.xy = r1.xy * r0.zz;
	r1.xy = saturate(-r0.zz * uniAuto_BorderCutValue.xx + r1.xy);
	r0.y = r0.y * r0.z;
	r0.y = 1 / r0.y;
	r0.z = -r1.x + r1.y;
	r0.y = saturate(r0.y * r0.z);
	r0.zw = r0.xx * float2(0.5, -0.5) + r0.ww;
	r1.x = uniAuto_StrokeParam.y * -uniAuto_StrokeParam.x + r2.w;
	r1.zw = float2(1, -9);
	r1.yz = r1.zw + -uniAuto_StrokeParam.xx;
	r1.y = -r1.x + r1.y;
	r1.z = 1 / r1.z;
	r1.w = 1 / r1.y;
	r2.xy = r0.zw * r1.ww;
	r0.zw = r0.wz * r1.zz;
	r0.zw = saturate(r1.zz * -10 + r0.zw);
	r1.z = r0.x * r1.z;
	r0.x = r0.x * r1.w;
	r1.xw = saturate(-r1.ww * r1.xx + r2.xy);
	r0.x = 1 / r0.x;
	r1.z = 1 / r1.z;
	r0.z = -r0.z + r0.w;
	r0.z = saturate(r1.z * r0.z);
	r0.w = r1.w * r1.w;
	r0.w = r1.x * r1.x + -r0.w;
	r0.w = r0.w * 0.5;
	r0.x = saturate(r0.x * r0.w);
	r0.x = -r0.x + r0.z;
	r0.x = (r1.y >= 0) ? r0.z : r0.x;
	r1 = i.color1.xyzx * float4(-1, -1, -1, -0) + i.color1;
	r1 = r0.x * r1;
	r1 = (r0.x >= 0) ? r1 : 0;
	r1 = i.color1.xyzx * float4(1, 1, 1, 0) + r1;
	r2 = half4(lerp(r1, i.color, r0.y));
	o.xyz = r2.xyz * uniHDRParam.yyy;
	o.w = r2.w;

	return o;
}

float4 main(PS_IN i) : COLOR0 {
  return RuseScaleUI(OriginalUI(i));
}
